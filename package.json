{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --concurrency auto --max-warnings 0",
    "lint:stats": "eslint . --concurrency auto --stats --format json",
    "lint:cached": "eslint . --cache --cache-strategy content --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "knip:strict": "knip --cache --reporter symbols --reporter cycles",
    "knip:strict:ci": "knip --cache --reporter symbols --reporter cycles --reporter github-actions",
    "knip:prod": "knip --cache --strict --reporter symbols --reporter cycles",
    "knip:prod:ci": "knip --cache --strict --reporter symbols --reporter cycles --reporter github-actions",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "knip": "^6.48.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "^8.3.8"
  }
}
